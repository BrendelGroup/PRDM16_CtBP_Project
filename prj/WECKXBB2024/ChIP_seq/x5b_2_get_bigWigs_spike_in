#!/bin/bash
#


#Generating bigWig files with deepTools bamCoverage

BAM_NSC_dir=./3_Alignments/bt2VSmm39dm6
ref_dir=../Genomes/genomeMM39
blacklist_regions=${ref_dir}/mm39.excluderanges.bed
OUTDIR_BW=./5_bigWigs



#The drosophila read counts that are generated from the previous script (x5b_1_countReadsForSpikeIn):
#The count of drosophila reads for the CTBP2wt_n_1 is: 599558

#The count of drosophila reads for the CTBP2wt_n_2 is: 322556

#The count of drosophila reads for the CTBP2ko_n_1 is: 344196

#The count of drosophila reads for the CTBP2ko_n_2 is: 368720



#The scale factors for the spike-in normalization were calculated based on the Active Motif ChIP-seq spike-in normalization protocol (https://www.activemotif.com/documents/1977.pdf)



#The scale factor for CTBP2wt_n_1 is: 322556/599558 = 0.54

#The scale factor for CTBP2wt_n_2 is: 322556/322556 = 1.0

#The scale factor for CTBP2ko_n_1 is: 322556/344196 = 0.95

#The scale factor for CTBP2ko_n_2 is: 322556/368720 = 0.88


echo 'CTBP2wt_n_1:'
echo ''
bamCoverage \
	-b ${BAM_NSC_dir}/CTBP2wt_n_1.mm39.bam \
	-o ${OUTDIR_BW}/CTBP2wt_n_1.bw \
	--numberOfProcessors max \
	--scaleFactor 0.54 \
	--binSize 10 \
	--blackListFileName ${blacklist_regions} \
	--extendReads \
	--smoothLength 30 \
	--centerReads
echo ''
echo ''

echo 'CTBP2wt_n_2:'
echo ''
bamCoverage \
	-b ${BAM_NSC_dir}/CTBP2wt_n_2.mm39.bam \
	-o ${OUTDIR_BW}/CTBP2wt_n_2.bw \
	--numberOfProcessors max \
	--scaleFactor 1.0 \
	--binSize 10 \
	--blackListFileName ${blacklist_regions} \
	--extendReads \
	--smoothLength 30 \
	--centerReads
echo ''
echo ''

echo 'CTBP2ko_n_1:'
echo ''
bamCoverage \
	-b ${BAM_NSC_dir}/CTBP2ko_n_1.mm39.bam \
	-o ${OUTDIR_BW}/CTBP2ko_n_1.bw \
	--numberOfProcessors max \
	--scaleFactor 0.95 \
	--binSize 10 \
	--blackListFileName ${blacklist_regions} \
	--extendReads \
	--smoothLength 30 \
	--centerReads
echo ''
echo ''

echo 'CTBP2ko_n_2:'
echo ''
bamCoverage \
	-b ${BAM_NSC_dir}/CTBP2ko_n_2.mm39.bam \
	-o ${OUTDIR_BW}/CTBP2ko_n_2.bw \
	--numberOfProcessors max \
	--scaleFactor 0.88 \
	--binSize 10 \
	--blackListFileName ${blacklist_regions} \
	--extendReads \
	--smoothLength 30 \
	--centerReads
