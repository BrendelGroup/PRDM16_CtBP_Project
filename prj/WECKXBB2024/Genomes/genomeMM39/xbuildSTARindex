#!/bin/bash
#


mkdir ./mm39STARidx

STARidx=./mm39STARidx
GENOME=./BSgenome.Mmusculus.UCSC.mm39chrs.fa
GTFfile=./mm39.gtf
NTHREADS=16


# Generate the STAR index for mm39
STAR \
	--runThreadN ${NTHREADS} \
	--runMode genomeGenerate \
	--genomeDir ${STARidx} \
	--genomeFastaFiles ${GENOME} \
	--sjdbGTFfile ${GTFfile}
