#!/bin/bash
#


peaks_dir=../ChIP_seq/4_Peaks
REP_PEAKS_dir=${peaks_dir}/Reproduced_Peaks
annotated_peaks_dir=${peaks_dir}/Annotated_Peaks

INTERSECTION_dir=./1_Intersections


bigWig_DIR=../ChIP_seq/5_bigWigs

ATS_dir=../ATAC_seq/4_bigWigs

ref_dir=../Genomes/genomeMM39
blacklist_regions=${ref_dir}/mm39.excluderanges.bed

HEAT_MAPS_dir=./3_Heat_Maps_and_Plots



###deepTools heat maps and profile projections

#CTBP2_Promoter_and_Intergenic_Peaks

computeMatrix reference-point --referencePoint center \
	--numberOfProcessors max \
	-R \
		${annotated_peaks_dir}/CTBP2_NSC_promoter_peaks.bed \
		${annotated_peaks_dir}/CTBP2_NSC_Intergenic_peaks.bed \
	-S \
		${bigWig_DIR}/CTBP2_e_n_average.bw \
		${bigWig_DIR}/H3K4me3_e_average.bw \
		${bigWig_DIR}/H3K27ac_e_average.bw \
		${bigWig_DIR}/H3K4me1_e_average.bw \
		${ATS_dir}/ats_e_average.bw \
	-b 3000 \
	-a 3000 \
	--missingDataAsZero \
	--skipZeros \
	--blackListFileName ${blacklist_regions} \
	-o ${HEAT_MAPS_dir}/CTBP2_Promoter_and_Intergenic_Peaks.gz

plotHeatmap \
	-m ${HEAT_MAPS_dir}/CTBP2_Promoter_and_Intergenic_Peaks.gz \
	--whatToShow "heatmap and colorbar" \
	--colorList \
		"white,#6F2DA8" \
		"white,#246BCE" \
		"white,#DA9100" \
		"white,#228B22" \
		"white,#246BCE" \
	--heatmapHeight 40 \
	--heatmapWidth 6 \
	-x "" \
	-z \
		"CTBP2 promoter peaks" \
		"CTBP2 intergenic peaks" \
	--zMin 0 0 0 0 0 \
	--zMax 20 20 12 8 24 \
	--samplesLabel \
		CTBP2 \
		H3K4me3 \
		H3K27ac \
		H3K4me1 \
		ATAC-Seq \
	-o ${HEAT_MAPS_dir}/Fig_2D.png


