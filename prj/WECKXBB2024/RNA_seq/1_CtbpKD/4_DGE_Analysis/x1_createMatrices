#!/bin/bash
#


# Specify the directory for the BAM files
BAM_FILES_DIR=../3_Alignments



# Extracting the gene names column
cut -d$'\t' -f1 ${BAM_FILES_DIR}/CtbpCTL_1/CtbpCTL_1_ReadsPerGene.out.tab > ./gene_column.tsv


# Extracting the needed columns from the gene counts files

RNS_EXPERIMENTS="CtbpCTL_1 CtbpCTL_2 CtbpCTL_3 CtbpCTL_4 CtbpKD_1 CtbpKD_2 CtbpKD_3 CtbpKD_4"

for experiment in ${RNS_EXPERIMENTS}
do
	cut -d$'\t' -f4 ${BAM_FILES_DIR}/${experiment}/${experiment}_ReadsPerGene.out.tab > ./${experiment}_counts_column.tsv
done


# Pasting the extracted columns in a raw counts matrix file and removing the temporary files

paste gene_column.tsv CtbpCTL_1_counts_column.tsv CtbpCTL_2_counts_column.tsv CtbpCTL_3_counts_column.tsv CtbpCTL_4_counts_column.tsv CtbpKD_1_counts_column.tsv CtbpKD_2_counts_column.tsv CtbpKD_3_counts_column.tsv CtbpKD_4_counts_column.tsv > CtbpKD_raw_counts_to_clean.tsv

sed -i '1,4d' CtbpKD_raw_counts_to_clean.tsv

echo -e "gene_id\tCtbpCTL_1\tCtbpCTL_2\tCtbpCTL_3\tCtbpCTL_4\tCtbpKD_1\tCtbpKD_2\tCtbpKD_3\tCtbpKD_4" > CtbpKD_raw_counts_headers.tsv

cat CtbpKD_raw_counts_headers.tsv CtbpKD_raw_counts_to_clean.tsv > v1a_CtbpKD_raw_counts.tsv

rm -rf gene_column.tsv
rm -rf *_counts_column.tsv
rm -rf CtbpKD_raw_counts_*.tsv


# Creating the samples to conditions matrix

echo -e "sample\tcondition" > temp_row_1.tsv
echo -e "CtbpCTL_1\tCTRL" > temp_row_2.tsv
echo -e "CtbpCTL_2\tCTRL" > temp_row_3.tsv
echo -e "CtbpCTL_3\tCTRL" > temp_row_4.tsv
echo -e "CtbpCTL_4\tCTRL" > temp_row_5.tsv
echo -e "CtbpKD_1\tKDN" > temp_row_6.tsv
echo -e "CtbpKD_2\tKDN" > temp_row_7.tsv
echo -e "CtbpKD_3\tKDN" > temp_row_8.tsv
echo -e "CtbpKD_4\tKDN" > temp_row_9.tsv

cat temp_* > v1b_CtbpKD_samples_to_conditions.tsv

rm -rf temp_*
