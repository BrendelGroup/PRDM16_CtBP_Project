#!/bin/bash
#


RNS_dir_PPC=./4_DGE_Analysis/1_PAX6
RNS_dir_TPC=./4_DGE_Analysis/2_TBR2
RNS_dir_combined=./5_Combine_PAX6_TBR2



# Concatenate a list of dysregulated genes from both the PAX6 and TBR2 positive cells experiments
cat ${RNS_dir_PPC}/v3a_Prdm16KO_PPC_upOrDownReg_genes.txt ${RNS_dir_TPC}/v3a_Prdm16KO_TPC_upOrDownReg_genes.txt | sort | uniq > ${RNS_dir_combined}/v1_upOrDownReg_genes_Prdm16KO_combined.txt

cat ${RNS_dir_PPC}/v3b_Prdm16KO_PPC_upReg_genes.txt ${RNS_dir_TPC}/v3b_Prdm16KO_TPC_upReg_genes.txt | sort | uniq > ${RNS_dir_combined}/v2_upReg_genes_Prdm16KO_combined.txt

cat ${RNS_dir_PPC}/v3c_Prdm16KO_PPC_downReg_genes.txt ${RNS_dir_TPC}/v3c_Prdm16KO_TPC_downReg_genes.txt | sort | uniq > ${RNS_dir_combined}/v3_downReg_genes_Prdm16KO_combined.txt
